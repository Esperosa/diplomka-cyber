# Zkopíruj do .env a vyplň před `docker compose up` (viz README "Nasazení").
# Náhodný token: `openssl rand -hex 32` nebo `python -c "import secrets; print(secrets.token_hex(32))"`.
BAKULA_API_TOKEN=

# Volitelne - zasahy (enforce.block_ip). Vychozi je dry-run; skutecne blokovani
# zapne jen presna hodnota "enforce" a ma smysl jen pri behu na brane s CAP_NET_ADMIN.
# BAKULA_ENFORCEMENT_MODE=dry_run
# Dalsi nezablokovatelne rozsahy (brana, DNS, management), carkou oddelene CIDR.
# BAKULA_PROTECTED_RANGES=192.168.1.1/32,192.168.1.53/32
# Logovani: BAKULA_LOG=info, BAKULA_LOG_FORMAT=json
